# -----------------------------------------------------------------------------
# DeployStack Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# DO NOT commit .env containing production secrets to version control.
# -----------------------------------------------------------------------------

# General Application Settings
PROJECT_NAME="DeployStack"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API & Security
SECRET_KEY="insecure-dev-secret-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (JSON string array)
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]'

# Relational Database (PostgreSQL)
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="deploystack"
POSTGRES_PASSWORD="deploystack_password"
POSTGRES_DB="deploystack_db"
# Database URL override (constructed automatically from parts above if omitted)
DATABASE_URL="postgresql://deploystack:deploystack_password@postgres:5432/deploystack_db"

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL="http://minio:9000"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_DEFAULT_REGION="us-east-1"
S3_BUCKET_NAME="deploystack-attachments"

# Frontend Configuration
VITE_API_URL="http://localhost:8000/api/v1"
VITE_APP_TITLE="DeployStack"
